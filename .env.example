# Server Environment Variables
# Copy this file to server/.env and fill in your own values.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.khaebld.mongodb.net/<dbname>?retryWrites=true&w=majority

# Local MongoDB (fallback for development)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/portfolio

# Force in-memory MongoDB in development (optional)
# MONGODB_USE_MEMORY=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=deksobups

